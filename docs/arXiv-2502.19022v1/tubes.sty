\ProvidesPackage{tubes}

\RequirePackage{tikz}
\usetikzlibrary{positioning,shapes.geometric,shapes.misc}

\pgfdeclarelayer{foreground}
\pgfdeclarelayer{background}
\pgfdeclarelayer{strings}
\pgfsetlayers{background,strings,foreground}

\newlength{\xlength} %global horz scaling
\newlength{\ylength} %global vert scaling
\newlength{\tubewidth}

\setlength{\xlength}{0.5cm}
\setlength{\ylength}{0.4cm}
\setlength{\tubewidth}{0.5\xlength}

\newif\iftop\pgfkeys{/tikz/top/.is if=top}
\newif\ifbot\pgfkeys{/tikz/bot/.is if=bot}
\newif\ifwidebelt\pgfkeys{/tikz/widebelt/.is if=widebelt}
\newif\ifwiderbelt\pgfkeys{/tikz/widerbelt/.is if=widerbelt}


\pgfdeclareshape{end}{
	\inheritsavedanchors[from=rectangle]
	\inheritanchorborder[from=rectangle]
	
	\savedanchor\centerpoint{
		\pgf@x=0pt
		\pgf@y=0pt
	}
	
	\savedanchor\leftpoint{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@x by -\tubewidth
	}
	
	\savedanchor\toppoint{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@y by 0.5\tubewidth
	}

	\savedanchor\clipzonel{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@x by -0.9\tubewidth
		\advance\pgf@y by \ylength
	}
	\savedanchor\clipzoner{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@x by 0.9\tubewidth
		\advance\pgf@y by -\ylength
	}
	
	\anchor{center}{\centerpoint}
		
	\backgroundpath{
		\begin{pgfonlayer}{background}
			\begin{pgfscope}
				\pgfpathmoveto{\leftpoint}
				\pgfpatharc{180}{0}{\tubewidth and 0.5\tubewidth}
				\pgfusepath{stroke}
			\end{pgfscope}
		\end{pgfonlayer}
		\begin{pgfonlayer}{foreground}
			\begin{pgfscope}
				\pgfpathrectanglecorners{\clipzonel}{\clipzoner}
				\pgfusepath{clip}
				\pgfpathmoveto{\leftpoint}
				\pgfpatharc{180}{0}{\tubewidth and -0.5\tubewidth}
				\pgfsetstrokecolor{white}
				\pgfsetlinewidth{4\pgflinewidth}
				\pgfusepath{stroke}
			\end{pgfscope}
			\begin{pgfscope}
				\pgfpathmoveto{\leftpoint}
				\pgfpatharc{180}{0}{\tubewidth and -0.5\tubewidth}
				\pgfusepath{stroke}
			\end{pgfscope}
		\end{pgfonlayer}
	}
}

