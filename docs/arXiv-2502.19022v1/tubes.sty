\pgfdeclareshape{pants}{
	\inheritsavedanchors[from=rectangle]
	\inheritanchorborder[from=rectangle]
	
	\savedanchor\centerpoint{
		\pgf@x=0pt
		\pgf@y=0pt
	}
	
	\savedanchor\top{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@y by \ylength
	}
	
	\savedanchor\topr{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@x by \tubewidth
		\advance\pgf@y by \ylength
		\ifwidebelt
			\advance\pgf@x by 0.5\tubewidth
		\fi
		\ifwiderbelt
			\advance\pgf@x by 1\tubewidth
		\fi
	}
	
	\savedanchor\topl{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@x by -\tubewidth
		\advance\pgf@y by \ylength
		\ifwidebelt
			\advance\pgf@x by -0.5\tubewidth
		\fi
		\ifwiderbelt
			\advance\pgf@x by -1\tubewidth
		\fi
	}
	
	\savedanchor\leftleg{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@x by -2\tubewidth
		\advance\pgf@y by -\ylength
	}
	
	\savedanchor\leftlegl{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@x by -3\tubewidth
		\advance\pgf@y by -\ylength
	}
	
	\savedanchor\leftlegr{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@x by -\tubewidth
		\advance\pgf@y by -\ylength
	}
	
	\savedanchor\rightleg{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@x by 2\tubewidth
		\advance\pgf@y by -\ylength
	}
	
	\savedanchor\rightlegl{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@x by \tubewidth
		\advance\pgf@y by -\ylength
	}
	
	\savedanchor\rightlegr{
		\pgf@x=0pt
		\pgf@y=0pt
		\advance\pgf@x by 3\tubewidth
		\advance\pgf@y by -\ylength
	}
	
	\anchor{center}{\centerpoint}
	\anchor{belt}{\top}
	\anchor{leftleg}{\leftleg}
	\anchor{rightleg}{\rightleg}
	
	\backgroundpath{
		\begin{pgfonlayer}{background}
			\pgfpathmoveto{\topl}
			\ifwiderbelt
				\pgfpathcurveto{\pgfpoint{-2\tubewidth}{0}}{\pgfpoint{-3\tubewidth}{0}}{\leftlegl}
			\else
				\ifwidebelt
					\pgfpathcurveto{\pgfpoint{-1.5\tubewidth}{0}}{\pgfpoint{-3\tubewidth}{0}}{\leftlegl}
				\else
					\pgfpathcurveto{\pgfpoint{-\tubewidth}{0}}{\pgfpoint{-3\tubewidth}{0}}{\leftlegl}
				\fi
			\fi
			\pgfusepath{stroke}
			\pgfpathmoveto{\topr}
			\ifwiderbelt
				\pgfpathcurveto{\pgfpoint{2\tubewidth}{0}}{\pgfpoint{3\tubewidth}{0}}{\rightlegr}
			\else
				\ifwidebelt
					\pgfpathcurveto{\pgfpoint{1.5\tubewidth}{0}}{\pgfpoint{3\tubewidth}{0}}{\rightlegr}
				\else
					\pgfpathcurveto{\pgfpoint{\tubewidth}{0}}{\pgfpoint{3\tubewidth}{0}}{\rightlegr}
				\fi
			\fi
			\pgfusepath{stroke}
			\pgfpathmoveto{\leftlegr}
			\pgfpathcurveto{\pgfpoint{-0.5\tubewidth}{-0.5\ylength}}{\pgfpoint{0.5\tubewidth}{-0.5\ylength}}{\rightlegl}
			\pgfusepath{stroke}
			\iftop
				{
				\pgftransformshift{\pgfpoint{0}{\ylength}}
				\ifwiderbelt
					\pgftransformscale{2}
					\pgfnode{end}{center}{}{}{}
				\else
					\ifwidebelt
						\pgftransformscale{1.5}
						\pgfnode{end}{center}{}{}{}
					\else
						\pgfnode{end}{center}{}{}{}
					\fi
				\fi
				}
			\fi
			\ifbot
				{
				\pgftransformshift{\pgfpoint{2\tubewidth}{-\ylength}}
				\pgfnode{end_dot}{center}{}{}{}
				\pgftransformshift{\pgfpoint{-4\tubewidth}{0}}
				\pgfnode{end_dot}{center}{}{}{}
				}
			\fi
		\end{pgfonlayer}
	}
}

